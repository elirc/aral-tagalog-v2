# copy to .env for local dev
DATABASE_URL=postgres://aral:aral@localhost:5433/aral
# required outside development (`pnpm dev` sets NODE_ENV=development, which
# permits a built-in dev fallback; any other environment refuses to boot
# without an explicit database URL and a secret of at least 32 bytes). Generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-secret-change-me
PORT=3001
# bind address (default 0.0.0.0 — containers and LAN devices can reach it)
# HOST=0.0.0.0
# Set to "true" ONLY when a trusted reverse proxy (Fly, Railway, a CDN) sits in
# front and sets X-Forwarded-For. Without it every request looks like it comes
# from the proxy, so rate limiting buckets the whole user base together and the
# 10/min auth limit becomes a global lockout. With it on a directly-exposed
# server, clients can spoof the header to get their own bucket.
# TRUST_PROXY=true
# How long a just-rotated refresh token may be replayed without being treated
# as theft (default 60000). Covers two tabs or two sync workers refreshing at
# once; set to 0 to exercise the revocation path in tests.
# REFRESH_REUSE_GRACE_MS=60000
# comma-separated browser origins allowed by CORS; unset = any origin in
# development, none otherwise. Set this when deploying the web app.
# CORS_ORIGIN=https://aral.example.com
# where compiled content lives (defaults to ../../packages/content/dist).
# Production refuses to start without valid manifest.json and sync_catalog.json.
# Run pnpm content:build to generate both artifacts.
# /health checks process liveness; /ready verifies content and database migrations.
# CONTENT_DIR=
# AUDIO_DIR=
