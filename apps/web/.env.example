# Copy to .env.local for local testing. Production on Vercel uses dashboard environment variables.
NEXT_PUBLIC_API_URL=/api
# Required for accounts and sync; guest lessons work without a database.
DATABASE_URL=postgres://aral:aral@localhost:5433/aral
# Generate a random 48-byte value before using production.
JWT_SECRET=replace-with-a-long-random-secret-before-deploying
