# Bare DNS name, without https:// or a path. Point its A/AAAA records at the host.
DOMAIN=aral.example.com
# Generate TWO DIFFERENT values: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Use URL-safe random strings for POSTGRES_PASSWORD because it is part of DATABASE_URL.
POSTGRES_PASSWORD=
JWT_SECRET=
